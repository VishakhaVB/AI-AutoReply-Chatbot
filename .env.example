# Debug Mode (set to True for development logs)
DEBUG=True

# Gemini API Key (Required for chat response generation)
# Obtain your key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Polling Interval (seconds to wait before checking for new messages)
POLLING_INTERVAL_SECONDS=5.0

# Target sender name to trigger reply logic
TARGET_SENDER_NAME=Rohan Das
