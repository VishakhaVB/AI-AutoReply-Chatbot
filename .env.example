# Debug Mode (set to True for development logs)
DEBUG=True

# Gemini API Key (Required for AI response, safety, and vision analysis)
# Obtain your key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Owner's name (Used to filter out own messages in chat logs)
MY_NAME=Me

# Polling Interval (seconds to wait before copying and checking chats)
POLLING_INTERVAL_SECONDS=5.0
